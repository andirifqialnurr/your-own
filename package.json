{
  "name": "your-own",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "24.18.0",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "dev:api": "pnpm --filter @your-own/api dev",
    "build": "pnpm --filter @your-own/api build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --filter @your-own/api typecheck",
    "test": "pnpm --filter @your-own/api test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:boundaries": "node --test scripts/architecture/*.test.mjs",
    "check": "pnpm test:boundaries && pnpm check:boundaries && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
